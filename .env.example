# ===== RIKOARDIANTO v2 — environment variables =====
# Salin ke .env.local, ganti value placeholder sesuai kebutuhan.

# URL utama website (dipakai untuk canonical/sitemap/OG di production)
NEXT_PUBLIC_SITE_URL=https://rikoardianto.web.id

# URL toko Shopee — ganti YOUR_SHOPEE_URL dengan link toko asli
NEXT_PUBLIC_SHOPEE_URL=YOUR_SHOPEE_URL

# URL WhatsApp untuk order produk — ganti angka dengan nomor asli
NEXT_PUBLIC_WHATSAPP_URL=YOUR_WHATSAPP_URL
